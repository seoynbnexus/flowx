NODE_ENV=development

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flowx
DB_POOL_LIMIT=10

# smtp config
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=465
SMTP_FROM=
SMTP_FROM_NAME=

# jwt
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=2m
JWT_REFRESH_EXPIRY=30d

# encryption for refresh tokens (AES-256) - must be 64 hex chars (32 bytes)
ENCRYPTION_KEY=

# hashing
SALT=10

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# timezone
TZ=Asia/Kolkata

# frontend URL (for email links etc.)
FRONTEND_URL=http://localhost:3000

# super admin seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# meta / facebook oauth (Instagram integration)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# AI Content Generation
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_MAX_PROMPT_LENGTH=1000
AI_RATE_LIMIT_RPM=30
AI_MODERATION_ENABLED=false
AI_MODERATION_PROVIDER=google
AI_SAFETY_POLICY_PATH=./shared/ai/ai-safety-policy.yamlhttp://localhost:3001/api/v1/publisher/accounts/oauth/callback

ENCRYPTION_KEY=