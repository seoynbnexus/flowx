NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flowx
DB_POOL_LIMIT=10

# smtp config
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=465
SMTP_FROM=
SMTP_FROM_NAME=

# jwt
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=2m
JWT_REFRESH_EXPIRY=30d

# system config
CAMPAIGN_JOB_CONCURRENCY=25
# extra hours of runway required beyond Meta's bare 24h daily-budget floor
# when a client SETS a campaign's end date/time (saveMetaSettings) — gives
# normal admin review turnaround room before that floor is reached, so a
# schedule that was fine when set doesn't drift invalid before publish
CAMPAIGN_SCHEDULE_SAFETY_BUFFER_HOURS=6
# run the background job worker / meta sync scheduler in this process (0 = web-only instance)
WORKER_ENABLED=1
SYNC_SCHEDULER_ENABLED=1

# retention (days) — single policy authority: shared/database/retention.js (TABLE_PURGES)
# leader-gated daily maintenance purges these in bounded batches; invalid values fall back to safe defaults
JOB_RETENTION_DAYS=7
ENGAGEMENT_RETENTION_DAYS=90
WEBHOOK_RETENTION_DAYS=30
META_SNAPSHOT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
AUTH_LOGIN_HISTORY_RETENTION_DAYS=365
# bounded batch deletion — hard ceiling 5000 x 50 = 250,000 rows/table/run (never tuned dynamically)
RETENTION_DELETE_BATCH=5000
RETENTION_MAX_BATCHES_PER_RUN=50
META_WEBHOOK_RPM=120
META_WEBHOOK_GLOBAL_RPM=600
META_WEBHOOK_CHECK_INTERVAL_HOURS=24

# encryption for refresh tokens (AES-256) - must be 64 hex chars (32 bytes)
ENCRYPTION_KEY=

# hashing
SALT=10

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# timezone
TZ=Asia/Kolkata

# frontend URL (for email links etc.)
FRONTEND_URL=http://localhost:3000

# super admin seed
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# meta / facebook oauth (Instagram integration)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_AD_ACCOUNT_ID=
META_SYSTEM_USER_TOKEN=
# set 1 to request read_insights in the Meta OAuth consent — ONLY after Meta grants Advanced Access for it
META_OAUTH_INSIGHTS_SCOPE=
# optional monthly spend cap for the primary account (paise; budget governor pauses campaigns at 100%)
META_MONTHLY_CAP_PAISE=0

# demo client (npm run db:seed:demo) — client-role account with coins for end-to-end testing
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
DEMO_CLIENT_COINS=10000

# Meta Graph webhooks (campaign status/spend push) — verify token set in the Meta app dashboard; signature falls back to META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_MAX_BYTES=524288

# Budget governor + leader election
META_SHED_ACCOUNT_LIMIT=3
INSTANCE_ID=

# PROCESS-LOCAL Meta request gate (NOT fleet-wide — each app process has its
# own gate; the DB worker lease serializes background job draining fleet-wide,
# and meta-rate-limiter provides shared per-account backoff state)
META_GLOBAL_CONCURRENCY=8
META_ACCOUNT_CONCURRENCY=4
# Backpressure: queued gate waiters beyond this many reject (errors flow into
# existing job backoff — no separate retry scheduler)
META_GATE_MAX_QUEUE=100
# Max time a gated Meta request may wait for a slot before erroring
META_GATE_WAIT_TIMEOUT_MS=20000
# Hard timeout on every outbound Meta HTTP call (apiFetch) — a hung call
# should never be able to pin a job "running" indefinitely
META_HTTP_TIMEOUT_MS=30000
# Sustained-rate ALERT signal (per-account rolling 60s window through the gate)
# — admin alert only, never a correctness limiter
META_RATE_ALERT_PER_MIN=120
# Account balance/snapshot polling cadence (admin snapshot consumer; budget
# governor reads DB charged-budget state, not this)
META_BALANCE_POLL_SECONDS=900

# Post engagement sync (organic posts) — hourly default
POST_ENGAGEMENT_SYNC_SECONDS=3600
# Safety floor: a DONE engagement job cannot be resurrected by the scheduler
# more than once per this many seconds (execution floor, not cadence)
POST_ENGAGEMENT_MIN_REQUEUE_SECONDS=300
# Engagement scheduler sweep gate — how often the leader tick probes for due posts
POST_ENGAGEMENT_SWEEP_SECONDS=60
# Per-target minimum interval between engagement Meta calls (webhook-targeted runs)
POST_ENGAGEMENT_TARGET_FLOOR_SECONDS=60
# Manual refresh cooldown floor (shorter so user refresh stays responsive)
POST_ENGAGEMENT_MANUAL_REFRESH_SECONDS=30

# Deleted-post monitoring — webhook-primary, per-target poller fallback
# Routine remote-existence check cadence for posted targets (~6h)
POST_DELETE_CHECK_SECONDS=21600
# Grace period before a deletion candidate can be confirmed (hours)
POST_DELETE_GRACE_HOURS=48
# Monitoring window from target posted_at — older targets stop polling (days)
POST_DELETE_MONITOR_DAYS=30
# Max targets per remote-health job batch
POST_DELETE_BATCH_LIMIT=100

# Boost ad performance (paid) — webhook-primary, Insights reconciliation fallback
# Fallback cadence when webhook freshness is stale/unavailable (~1h)
POST_BOOST_SYNC_SECONDS=3600
# Reconciliation cadence when webhook activity is healthy (~6h)
POST_BOOST_WEBHOOK_SYNC_SECONDS=21600
# A target counts as webhook-healthy if it received a boost webhook within this window
POST_BOOST_WEBHOOK_FRESH_SECONDS=21600

# Media library (uploaded images/videos for posts + campaigns)
# Per-user total storage quota and per-file cap (bytes)
POST_MEDIA_QUOTA_BYTES=536870912
POST_MEDIA_MAX_FILE_BYTES=209715200
# Public origin serving uploaded media (used to build absolute media URLs for Meta) — e.g. https://api.swarajorganiccommunity.com
PUBLIC_BASE_URL=

# Facebook Reel durable publish state machine (background sentinel jobs)
# Verify backoff between ambiguous-upload / post_id-resolution checks (seconds)
POST_FB_REEL_VERIFY_BACKOFF_SECONDS=60
# Processing poll before declaring the reel UNKNOWN and verifying (ms)
POST_FB_REEL_PROCESSING_CAP_MS=1800000
# Max verification cycles before a reel target is parked in MANUAL_REVIEW
POST_FB_REEL_VERIFY_CAP=3

# Instagram durable video publish state machine (reels + video stories)
# Parked container-status poll interval between sentinel job ticks (seconds)
POST_IG_POLL_SECONDS=5
# Container processing poll before declaring the target UNKNOWN and verifying (ms)
POST_IG_PROCESSING_CAP_MS=1800000
# Backoff for ambiguous publish recovery (seconds)
POST_IG_VERIFY_BACKOFF_SECONDS=60

# Instagram IMAGE container readiness FSM (feed/post images only; stories stay inline)
# Durable create -> readiness-poll -> publish lifecycle. Default OFF.
# When OFF, images publish inline (with 9007 classified retryable).
INSTAGRAM_IMAGE_CONTAINER_READINESS_ENABLED=false
# Parked readiness-poll interval between sentinel job ticks (seconds)
POST_IG_IMAGE_POLL_SECONDS=5
# Dedicated image readiness cap: IN_PROGRESS beyond this (ms) -> UNKNOWN + verify (backstop, not the normal path)
POST_IG_IMAGE_PROCESSING_CAP_MS=600000

# AI Content Generation
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_MAX_PROMPT_LENGTH=1000
AI_RATE_LIMIT_RPM=30
AI_MODERATION_ENABLED=false
AI_MODERATION_PROVIDER=google
AI_SAFETY_POLICY_PATH=./shared/ai/ai-safety-policy.yamlhttp://localhost:3001/api/v1/publisher/accounts/oauth/callback

ENCRYPTION_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Promotions (new Promotion/PromotionTarget boost architecture)
# Feature flags live in the app_config DB table, not env:
#   promotions_enabled (default false) — master flag: no new Promotions are created/executed when false; legacy post_boost continues
#   promotion_publish_trigger_enabled (default false) — wake-hook flag: enqueue promotion_execute when a PostTarget becomes POSTED
# BILLING (temporary, documented): both Flow A (post-creation boost) and Flow B (POST /posts/:postId/promotions)
# charge coins IMMEDIATELY at creation via coin.service.spend + post_billing_entries 'charge'.
# Escrow/reserve → capture-on-active settlement is planned as a SEPARATE future deployment.
# Set both flags to true (via admin/DB) to enable the new promotion flow per environment.
