NODE_ENV=development

PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flowx
DB_POOL_LIMIT=10

# smtp config
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=465
SMTP_FROM=
SMTP_FROM_NAME=

# jwt
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=2m
JWT_REFRESH_EXPIRY=30d

# encryption for refresh tokens (AES-256) - must be 64 hex chars (32 bytes)
ENCRYPTION_KEY=

# hashing
SALT=10

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# timezone
TZ=Asia/Kolkata
